{% comment %}
  24SEVEN E-Kiosk – Design-Token-System
  Alle Farben, Radien, Abstände und Typo-Skalen zentral als CSS Custom Properties.
  Wird im <head> von layout/theme.liquid gerendert.
{% endcomment %}
<style>
  :root {
    /* Farben – Dark Neon Kiosk */
    --color-bg: #0c0a14;
    --color-bg-secondary: #141021;
    --color-card: #1b1530;
    --color-card-hover: #241b3e;
    --color-border: rgba(139, 92, 246, 0.18);
    --color-border-strong: rgba(139, 92, 246, 0.4);

    --color-accent: #8b5cf6;
    --color-accent-2: #a855f7;
    --color-accent-pink: #e879f9;
    --color-success: #34d399;
    --color-warning: #fbbf24;
    --color-danger: #f87171;

    --color-text: #f4f1fb;
    --color-text-muted: #a89fc4;
    --color-text-dim: #6f6690;

    /* Glows – dezent einsetzen */
    --glow-accent: 0 0 24px rgba(139, 92, 246, 0.35);
    --glow-pink: 0 0 20px rgba(232, 121, 249, 0.3);
    --glow-success: 0 0 16px rgba(52, 211, 153, 0.3);

    /* Radien */
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-pill: 999px;

    /* Typografie */
    --font-heading: 'Archivo', 'Inter', system-ui, sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.125rem;
    --text-xl: 1.375rem;
    --text-2xl: 1.75rem;
    --text-3xl: clamp(2rem, 4vw, 2.75rem);
    --text-hero: clamp(2.25rem, 6vw, 4rem);

    /* Abstände */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-12: 3rem;
    --space-16: 4rem;

    /* Layout */
    --page-width: 1240px;
    --header-height: 64px;

    /* Transitions */
    --transition-fast: 150ms ease;
    --transition-base: 250ms ease;
  }
</style>
