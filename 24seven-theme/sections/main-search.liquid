<div class="page-width section-spacing">
  <h1>Suche</h1>
  <form action="{{ routes.search_url }}" method="get" class="newsletter-form" style="margin: 0 0 var(--space-8);">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Wonach suchst du?" aria-label="Suchbegriff" style="flex:1; background: var(--color-bg); border:1px solid var(--color-border-strong); border-radius: var(--radius-md); padding: 0.8rem 1rem; color: var(--color-text);">
    <button type="submit" class="btn btn--primary">Suchen</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="text-muted">{{ search.results_count }} Treffer für „{{ search.terms }}“</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Suche",
  "settings": []
}
{% endschema %}
