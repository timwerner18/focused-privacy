<section class="section-spacing" style="background: var(--color-bg-secondary);">
  <div class="page-width">
    <div class="section-heading">
      <span class="kicker">So funktioniert's</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="steps-grid">
      <div class="step-card">
        <h3>Bestellen</h3>
        <p>Sortiment durchstöbern, in den Warenkorb, Alter bestätigen – fertig. 24/7, wie am Automaten.</p>
      </div>
      <div class="step-card">
        <h3>Versand aus Sachsen</h3>
        <p>Wir packen deine Bestellung direkt bei uns in der Region und geben sie an DHL.</p>
      </div>
      <div class="step-card">
        <h3>1–3 Tage Lieferzeit</h3>
        <p>Im Raum Erzgebirge/Zwickau oft schon am nächsten Tag bei dir.</p>
      </div>
      <div class="step-card">
        <h3>Ausweis bei Zustellung</h3>
        <p>Bei 18+-Produkten prüft DHL dein Alter an der Tür (Alterssichtprüfung 18+). Ausweis bereithalten!</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "So funktioniert's",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Vom Klick bis zur Haustür" }
  ],
  "presets": [{ "name": "So funktioniert's" }]
}
{% endschema %}
