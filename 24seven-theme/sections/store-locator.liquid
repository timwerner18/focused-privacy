{%- comment -%} Store-Locator-Teaser: beide Kioske, 24/7-Hinweis {%- endcomment -%}
<section class="section-spacing">
  <div class="page-width">
    <div class="section-heading">
      <span class="kicker">Vor Ort</span>
      <h2>{{ section.settings.heading }}</h2>
      <p class="text-muted">Sofort brauchen? Hol's am Automaten – 24/7.</p>
    </div>
    <div class="locator-grid">
      {%- for block in section.blocks -%}
        <div class="locator-card" {{ block.shopify_attributes }}>
          <span class="open-badge">● 24/7 geöffnet</span>
          <h3>{{ block.settings.name }}</h3>
          <address>{{ block.settings.address }}</address>
          {%- if block.settings.maps_url != blank -%}
            <a href="{{ block.settings.maps_url }}" target="_blank" rel="noopener">Route planen →</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="text-center" style="margin-top: var(--space-6);">
      <a href="/pages/standorte" class="btn btn--secondary">Alle Infos zu unseren Kiosken</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Store-Locator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Unsere Kioske in Aue & Zwickau" }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Standort",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "24SEVEN Kiosk" },
        { "type": "textarea", "id": "address", "label": "Adresse" },
        { "type": "url", "id": "maps_url", "label": "Google-Maps-Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Store-Locator",
      "blocks": [
        { "type": "location", "settings": { "name": "24SEVEN Kiosk Aue", "address": "Postplatz 4, 08280 Aue-Bad Schlema" } },
        { "type": "location", "settings": { "name": "24SEVEN Kiosk Zwickau", "address": "ADRESSE EINTRAGEN, 08056 Zwickau" } }
      ]
    }
  ]
}
{% endschema %}
