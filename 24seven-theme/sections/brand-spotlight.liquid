{%- comment -%} Happy's Amsterdam Brand-Sektion mit eigenem Hero-Banner {%- endcomment -%}
{%- assign col = collections[section.settings.collection] -%}
<section class="section-spacing">
  <div class="page-width">
    <div class="brand-spotlight">
      <div class="brand-spotlight__grid">
        <div>
          <span class="brand-spotlight__kicker">{{ section.settings.kicker }}</span>
          <h2>{{ section.settings.heading }}</h2>
          <p class="text-muted">{{ section.settings.text }}</p>
          <a href="{{ col.url | default: '#' }}" class="btn btn--pink">{{ section.settings.cta_label }}</a>
        </div>
        <div class="product-grid" style="grid-template-columns: repeat(2, 1fr);">
          {%- for product in col.products limit: 2 -%}
            {% render 'product-card', product: product %}
          {%- else -%}
            {%- for i in (1..2) -%}
              <article class="product-card">
                <div class="product-card__media"><div class="placeholder-media">🌴</div></div>
                <div class="product-card__info"><h3 class="product-card__title">Sorten-Platzhalter</h3></div>
              </article>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand-Spotlight",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Exklusiv bei uns" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Happy's Amsterdam" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Die Sorten, die du vom Automaten kennst – Forbidden Fruit, Mango Safari, Golden Kush & mehr. Online bestellen und sparen: am Automaten 29,90 €, online günstiger." },
    { "type": "text", "id": "cta_label", "label": "CTA-Text", "default": "Alle Sorten ansehen" }
  ],
  "presets": [{ "name": "Brand-Spotlight" }]
}
{% endschema %}
