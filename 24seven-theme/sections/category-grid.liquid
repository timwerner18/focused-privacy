{%- comment -%} Kategorien-Grid: 8 Kacheln, per Blocks konfigurierbar {%- endcomment -%}
<section class="section-spacing">
  <div class="page-width">
    <div class="section-heading">
      <span class="kicker">Sortiment</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        <a href="{{ col.url | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
          <span class="category-card__emoji">{{ block.settings.emoji }}</span>
          <span class="category-card__title">{{ block.settings.title | default: col.title }}</span>
          {%- if col != blank -%}
            <span class="category-card__count">{{ col.products_count }} Produkte</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorien-Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Alles wie am Automaten. Nur bequemer." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie-Kachel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titel (optional, sonst Collection-Name)" },
        { "type": "text", "id": "emoji", "label": "Emoji/Icon", "default": "🛍️" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Kategorien-Grid",
      "blocks": [
        { "type": "category", "settings": { "emoji": "💨", "title": "Vapes & Liquids" } },
        { "type": "category", "settings": { "emoji": "🌴", "title": "Happy's Amsterdam" } },
        { "type": "category", "settings": { "emoji": "🫐", "title": "Onlygrams & H3BTA" } },
        { "type": "category", "settings": { "emoji": "🥤", "title": "Getränke" } },
        { "type": "category", "settings": { "emoji": "🍫", "title": "Snacks & Sweets" } },
        { "type": "category", "settings": { "emoji": "🚬", "title": "Tabak & Drehzubehör" } },
        { "type": "category", "settings": { "emoji": "🎁", "title": "Mystery Packs" } },
        { "type": "category", "settings": { "emoji": "🔥", "title": "Bundles & Deals" } }
      ]
    }
  ]
}
{% endschema %}
