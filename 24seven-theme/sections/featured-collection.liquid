{%- comment -%}
  Wiederverwendbare Produkt-Slider/Grid-Section – für "Bestseller",
  "Neu im Kiosk" und "Bundles & Deals" auf der Startseite.
{%- endcomment -%}
{%- assign col = collections[section.settings.collection] -%}
<section class="section-spacing">
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="text-muted">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="product-grid">
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media"><div class="placeholder-media">🛍️</div></div>
            <div class="product-card__info">
              <h3 class="product-card__title">Produkt-Platzhalter</h3>
              <div class="price-compare"><span class="price-compare__online">–,– €</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank and col != blank -%}
      <div class="text-center" style="margin-top: var(--space-8);">
        <a href="{{ col.url }}" class="btn btn--secondary">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produkt-Auswahl",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker (klein, über Überschrift)" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bestseller" },
    { "type": "text", "id": "subheading", "label": "Unterzeile" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "cta_label", "label": "CTA-Text (leer = kein Button)", "default": "Alle ansehen" }
  ],
  "presets": [{ "name": "Produkt-Auswahl" }]
}
{% endschema %}
