{%- comment -%} FAQ-Accordion mit FAQPage-Schema (JSON-LD) {%- endcomment -%}
<section class="section-spacing" style="background: var(--color-bg-secondary);">
  <div class="page-width">
    <div class="section-heading">
      <span class="kicker">FAQ</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="faq-list">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage" },
        { "type": "richtext", "id": "answer", "label": "Antwort" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Wie lange dauert die Lieferung?", "answer": "<p>1–3 Werktage mit DHL. Im Raum Erzgebirge/Zwickau (PLZ 08xxx/09xxx) bist du in der Express-Region – da ist dein Paket oft schon am nächsten Tag da.</p>" } },
        { "type": "faq", "settings": { "question": "Wie läuft die Altersprüfung ab?", "answer": "<p>Zweistufig: Beim Bestellen verifizieren wir dein Alter online. Bei der Zustellung von 18+-Produkten prüft DHL zusätzlich deinen Ausweis (Alterssichtprüfung 18+). Zustellung nur an dich persönlich – Ausweis bereithalten.</p>" } },
        { "type": "faq", "settings": { "question": "Wie kann ich bezahlen?", "answer": "<p>Alle im Checkout angezeigten Zahlarten, z. B. Vorkasse/Überweisung und weitere. Die verfügbaren Optionen siehst du im letzten Bestellschritt.</p>" } },
        { "type": "faq", "settings": { "question": "Kann ich meine Bestellung zurückgeben?", "answer": "<p>Du hast 14 Tage Widerrufsrecht. Ausgenommen sind aus Hygienegründen entsiegelte Produkte (z. B. geöffnete Vapes oder Lebensmittel). Details in der <a href=\"/pages/widerruf\">Widerrufsbelehrung</a>.</p>" } }
      ]
    }
  ]
}
{% endschema %}
