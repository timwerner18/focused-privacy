{%- comment -%} Preisvorteil-Story: Online sparen gegenüber dem Kiosk {%- endcomment -%}
<section class="section-spacing">
  <div class="page-width">
    <div class="brand-spotlight" style="text-align:center;">
      <span class="badge badge--save" style="font-size: var(--text-sm);">💸 Online günstiger</span>
      <h2 style="margin-top: var(--space-4);">{{ section.settings.heading }}</h2>
      <p class="text-muted" style="max-width: 620px; margin: 0 auto var(--space-6);">{{ section.settings.text }}</p>
      <a href="{{ section.settings.cta_url }}" class="btn btn--primary">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Preisvorteil-Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Online sparen gegenüber dem Kiosk – bei gleicher Auswahl." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Am Automaten zahlst du den Sofort-Preis. Online bekommst du dieselben Produkte günstiger – du siehst bei jedem Artikel den Automaten-Preis und deinen Online-Vorteil." },
    { "type": "text", "id": "cta_label", "label": "CTA-Text", "default": "Deals entdecken" },
    { "type": "url", "id": "cta_url", "label": "CTA-Link" }
  ],
  "presets": [{ "name": "Preisvorteil-Banner" }]
}
{% endschema %}
